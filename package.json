{
  "name": "cloudflare-workers-openapi",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply crud-test-api-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply crud-test-api-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chanfana": "^3.3.0",
    "hono": "^4.12.12",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  }
}
